{
  "command_tasks": [
    {
      "id": 1,
      "name": "dir",
      "parts": [
        {"Fixed": "dir"},
        {"Param": {"name": "显示模式", "options": ["/w", "/a", "/s", "/a /s"]}}
      ],
      "is_blocking": false,
      "group": "目录查看",
      "note": "列出当前目录下的文件和文件夹\n/w 宽列表模式\n/a 显示隐藏文件\n/s 递归子目录"
    },
    {
      "id": 2,
      "name": "tree",
      "parts": [
        {"Fixed": "tree"},
        {"Param": {"name": "选项", "options": ["/f", "/a", "/f /a"]}}
      ],
      "is_blocking": false,
      "group": "目录查看",
      "note": "以树形结构显示目录层级\n/f 同时显示文件名\n/a 使用ASCII字符"
    },
    {
      "id": 3,
      "name": "切换目录并查看",
      "parts": [
