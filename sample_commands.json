        {"Dir": {"key": "目标目录"}},
        {"Fixed": " && dir"}
      ],
      "is_blocking": false,
      "group": "目录查看",
      "note": "切换到指定目录并列出内容\ncd /d 支持跨盘符切换"
    },
    {
